<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 WiFi QR"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR স্ক্যান করো, বা নিজের WiFi-র QR বানাও"
            android:textColor="#dbeafe"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnModeScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📷 স্ক্যান" />

        <Button
            android:id="@+id/btnModeGen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="➕ বানাও" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- SCAN -->
            <LinearLayout
                android:id="@+id/scanBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextureView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="#000000" />

                <TextView
                    android:id="@+id/scanHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="WiFi-র QR কোডটা ক্যামেরার সামনে ধরো।"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/resultBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/resultSsid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WiFi: —"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/resultSec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="নিরাপত্তা: —"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/resultPass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="পাসওয়ার্ড: —"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnConnect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/navy"
                        android:text="✅ এই WiFi-তে যুক্ত হও"
                        android:textColor="#ffffff" />

                    <Button
                        android:id="@+id/btnCopyPass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 পাসওয়ার্ড কপি করো" />

                    <Button
                        android:id="@+id/btnScanAgain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 আবার স্ক্যান করো" />

                    <TextView
                        android:id="@+id/resultNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:text=""
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- GENERATE -->
            <LinearLayout
                android:id="@+id/genBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi-র নাম"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSsid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="যেমন: Aanisha"
                    android:inputType="text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="পাসওয়ার্ড"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="WiFi-র পাসওয়ার্ড লেখো"
                    android:inputType="textPassword" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="নিরাপত্তা"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spSec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <CheckBox
                    android:id="@+id/cbHidden"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="লুকানো নেটওয়ার্ক (নাম দেখা যায় না)" />

                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/navy"
                    android:text="➕ QR বানাও"
                    android:textColor="#ffffff" />

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="256dp"
                    android:layout_height="256dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSaveQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💾 QR ছবি সেভ করো"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/genNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="যে WiFi-তে এখন যুক্ত আছো, তার নাম উপরে বসিয়ে দিয়েছি। পাসওয়ার্ড তোমাকে লিখতে হবে — অ্যাপ সেভ করা পাসওয়ার্ড দেখতে পারে না।"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
